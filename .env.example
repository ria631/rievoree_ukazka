# Copy to .env.local and fill in. For local dev, `supabase start` prints both
# values (API URL + anon key). NEVER put the service_role key in frontend env.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key

# --- ETL worker (docker-compose) ---------------------------------------------
# The worker downloads uploaded files from Storage with the service_role key
# (server-side only — never expose it to the frontend). `supabase status -o env`
# prints SERVICE_ROLE_KEY for local dev.
WORKER_SERVICE_ROLE_KEY=your-local-service-role-key
# Set where the worker runs, so the Ingest page also accepts .xlsx (the worker
# is the only XLSX reader; CSV is parsed in the browser everywhere):
# VITE_XLSX_WORKER=true
# Optional overrides:
# WORKER_SUPABASE_URL=http://host.docker.internal:54321
# WORKER_POLL_MS=2000
# WORKER_ID=etl-worker-1

# --- Connectors ---------------------------------------------------------------
# The spreadsheet-link connector needs no secrets: Postgres fetches the public
# link itself (pg_net) and pg_cron re-reads it hourly. The webhook connector
# signs with a per-connector secret the app generates. (The Google Drive OAuth
# connector was retired in migration 41.)

# --- User management: invite / reset emails (edge function) ------------------
# Where invite + password-reset links land in the app (admin-users edge fn).
# Must also be added under Auth → URL Configuration → Redirect URLs.
#   APP_BASE_URL=https://your-frontend            (e.g. https://rievoree-ukazka.vercel.app)
# Local: APP_BASE_URL=http://localhost:5173

# --- Social login providers (Supabase Auth) ----------------------------------
# Enable "Sign in with Google / GitHub". These are read by config.toml.
#   SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID / SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET
#   SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID / SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET

# --- Review e-mails (optional) -----------------------------------------------
# When a batch is held for review, a trigger calls the notify-review edge
# function through pg_net. Its endpoint lives in Vault (never in a migration):
#   select vault.create_secret('<functions-url>/notify-review', 'edge_notify_review_url');
#   select vault.create_secret('<service_role JWT>',           'edge_service_role_key');
